<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />
    <!--
        Lets the app hand an update it downloaded to Android's installer.
        Android still asks the user to confirm every install, and to allow
        Kharcha as a source the first time.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!--
        Reading bank and wallet payment alerts, so they can be added as
        transactions without typing. Asked for only when the user starts a
        scan from More > Import from SMS; the messages are read on the phone
        and nothing leaves it until the user picks what to import.
    -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />
    <!--
        Approximate only, and only for the weather on the Calendar page. Asked
        for from Settings > App Permissions, never by opening the Calendar.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!--
        The location plugin also brings a permission for tracking location
        from a background service. Kharcha only reads the location once, while
        the Calendar page is open, so that permission is taken back out.
    -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_LOCATION"
        tools:node="remove" />

    <!--
        No backup of the app's storage: see res/xml/data_extraction_rules.xml.
        Removing the app and installing it again is a fresh installation.
    -->
    <application
        android:label="Kharcha"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        tools:targetApi="s">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- What a long press on the app icon offers. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
            <!--
                Statements shared into the app: "Share" on a PDF, Excel or CSV
                statement in a bank app or a file manager lists Kharcha, and
                the file opens in the statement importer. Only these file
                types are claimed, so Kharcha is not offered for photos, links
                or text.

                No storage permission is needed: the sending app lends this
                activity access to the one file, which MainActivity copies
                into the app's own cache at once.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="text/comma-separated-values" />
                <data android:mimeType="application/csv" />
                <data android:mimeType="application/vnd.ms-excel" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
            </intent-filter>
            <!-- "Open with" from a file manager or a download notification. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="text/comma-separated-values" />
                <data android:mimeType="application/csv" />
                <data android:mimeType="application/vnd.ms-excel" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
            </intent-filter>
        </activity>
        <!--
            Lends Android's installer the update the app downloaded. Not
            exported: access is granted to the installer for that one file,
            for that one install.
        -->
        <provider
            android:name=".UpdateFileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>
        <!--
            The home-screen widgets: today's spending, this month, and quick
            actions. Exported because it is the launcher, another app, that
            asks them to draw; they accept nothing but Android's own widget
            update.
        -->
        <receiver
            android:name=".KharchaWidgetProvider"
            android:exported="true"
            android:label="@string/app_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/kharcha_widget_info" />
        </receiver>
        <receiver
            android:name=".KharchaMonthWidgetProvider"
            android:exported="true"
            android:label="@string/app_widget_this_month">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/kharcha_widget_month_info" />
        </receiver>
        <receiver
            android:name=".KharchaActionsWidgetProvider"
            android:exported="true"
            android:label="@string/app_widget_actions_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/kharcha_widget_actions_info" />
        </receiver>
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!--
            FCM services are declared by the firebase_messaging plugin's own
            manifest and must not be re-declared here.

            Re-declaring FlutterFirebaseMessagingBackgroundService would
            override the plugin's `android:permission="BIND_JOB_SERVICE"`,
            which the OS checks when binding the JobService - dropping it
            silently breaks background and terminated delivery. Adding a second
            MESSAGING_EVENT filter also gives two services a claim on the same
            message.

            Background/terminated pushes are handled by
            kharchaFirebaseMessagingBackgroundHandler in Dart, which
            firebase_messaging invokes through that background service.
        -->

        <!--
            Firebase Cloud Messaging defaults.

            The app renders its own notifications from data messages (see
            PushNotificationService), so these only apply to the rare message
            that arrives as a system `notification` payload.

            Android does not let an app change a channel's importance or sound
            after the user has seen it, so the channel ids here are permanent
            API and must match PushNotificationService.channels.
        -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="@string/notification_channel_default" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_accent" />
    </application>
    <queries>
        <!-- Lets the app open links, the mail app and the dialer (Android 11+
             hides other apps unless the intents are declared here). -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <!-- The phone's speech recogniser, for adding a transaction by voice. -->
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>
</manifest>
