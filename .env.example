SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY


# Optional: pin the key-less weather accent to a specific place.
# Leave blank to auto-detect your approximate location from your IP.
# These are NOT secrets.
WEATHER_LAT=
WEATHER_LON=

# Optional: the Google Cloud project's *Web application* OAuth client id,
# needed for Google Drive backup when android/app/google-services.json does
# not carry one. An OAuth client id is public, NOT a secret.
# See docs/google-drive-setup.md.
GOOGLE_SERVER_CLIENT_ID=
